  DELFILE %APPDATA%\Microsoft\Internet Explorer\Quick Launch\Microsoft Edge.lnk
  DELFILE %APPDATA%\Microsoft\Internet Explorer\Quick Launch\User Pinned\TaskBar\Microsoft Edge.lnk
