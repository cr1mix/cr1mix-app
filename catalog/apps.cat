tweak apps.edgeremove | delete_forever | action risk2
  name  Remove Microsoft Edge
  desc  Uninstalls Edge and Edge Update, removes their services, tasks, shortcuts, protocol handlers and startup entries, and blocks reinstalls. The WebView2 runtime that other apps need is kept. Your Edge profile folder is kept too. Install another browser first.
  KILL  msedge
  KILL  MicrosoftEdgeUpdate
  KILL  MicrosoftEdge
  KILL  identity_helper
  KILL  msedge_proxy
  KILL  MicrosoftEdgeUpdateBroker
  KILL  MicrosoftEdgeUpdateOnDemand
  T     delete \MicrosoftEdgeUpdateTaskMachineCore*
  T     delete \MicrosoftEdgeUpdateTaskMachineUA*
  T     delete \MicrosoftEdgeUpdateBrowserReplacement*
  R     HKLM\SOFTWARE\WOW6432Node\Microsoft\EdgeUpdateDev | AllowUninstall | d:1 | -
  R-    HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Microsoft Edge | NoRemove
  R-    HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Microsoft Edge Update | NoRemove
  A     Microsoft.MicrosoftEdge
  A     Microsoft.MicrosoftEdge.Stable
  A     Microsoft.MicrosoftEdgeDevToolsClient
  A     Microsoft.Edge.GameAssist
  RUNGLOB %ProgramFiles(x86)%\Microsoft\Edge\Application\*\Installer\setup.exe | --uninstall --system-level --verbose-logging --force-uninstall
  RUNGLOB %ProgramFiles%\Microsoft\Edge\Application\*\Installer\setup.exe | --uninstall --system-level --verbose-logging --force-uninstall
  RUNREG HKLM\SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate | UninstallCmdLine
  SVCDEL edgeupdate edgeupdatem MicrosoftEdgeElevationService
  DELDIR %ProgramFiles%\Microsoft\Edge
  DELDIR %ProgramFiles(x86)%\Microsoft\Edge
  DELDIR %ProgramFiles%\Microsoft\EdgeUpdate
  DELDIR %ProgramFiles(x86)%\Microsoft\EdgeUpdate
  DELDIR %ProgramFiles%\Microsoft\EdgeCore
  DELDIR %ProgramFiles(x86)%\Microsoft\EdgeCore
