  DELDIR %LOCALAPPDATA%\Microsoft\EdgeCore
  DELFILE %ProgramData%\Microsoft\Windows\Start Menu\Programs\Microsoft Edge.lnk
  DELFILE %PUBLIC%\Desktop\Microsoft Edge.lnk
